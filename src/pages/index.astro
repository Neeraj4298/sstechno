---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { primaryPhone, telHref, waHref } from '../lib/contact';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import BookingForm from '../components/BookingForm.astro';
import {
  CheckCircle2,
  Clock,
  MapPin,
  Phone,
  MessageCircle,
  Snowflake,
  Refrigerator,
  WashingMachine,
  Microwave,
  Wrench,
  Home,
  FileCheck,
  UserCheck,
  ArrowRight,
} from 'lucide-astro';

const primary = primaryPhone();

const appliances = [
  { label: 'AC', icon: Snowflake },
  { label: 'Refrigerator', icon: Refrigerator },
  { label: 'Washing Machine', icon: WashingMachine },
  { label: 'Microwave', icon: Microwave },
];
---

<Layout title={siteConfig.seo.defaultTitle} description={siteConfig.seo.defaultDescription}>
  <!-- 1. Hero -->
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-brand-ink text-white">
    <div
      class="absolute inset-0 pointer-events-none bg-[radial-gradient(#ffffff18_1px,transparent_1px)] bg-[length:24px_24px]"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_top_right,rgba(45,212,191,0.12),transparent_60%)]"
      aria-hidden="true"
    ></div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center space-x-2 bg-white/5 border border-white/15 rounded-full px-4 py-1.5 mb-6">
            <span class="flex h-2 w-2 rounded-full bg-brand-accent-light"></span>
            <span class="text-slate-200 text-xs sm:text-sm font-medium tracking-wide">
              Serving {siteConfig.location.city}, {siteConfig.location.state}
            </span>
          </div>

          <h1 class="text-fluid-h1 text-white mb-4">
            {siteConfig.heroTagline}
            <span class="sr-only"> — Appliance Repair in {siteConfig.location.city}</span>
          </h1>

          <p class="text-lg md:text-2xl font-display font-medium text-brand-accent-light mb-4">
            {siteConfig.subhead}
          </p>

          <p class="text-base md:text-lg text-slate-300 mb-8 max-w-2xl leading-relaxed">
            {siteConfig.businessName} provides professional inspection, repair, maintenance and replacement parts for ACs, refrigerators, washing machines and microwave ovens with convenient doorstep assistance.
          </p>

          <div class="flex flex-col sm:flex-row flex-wrap gap-3.5 mb-8">
            <a
              href="#booking"
              class="bg-brand-accent text-white px-7 py-3.5 rounded-xl font-semibold text-base text-center hover:bg-brand-accent/90 transition-colors shadow-sm"
            >
              Book a Service
            </a>
            <a
              href={telHref(primary.e164)}
              class="bg-white text-brand-ink px-7 py-3.5 rounded-xl font-semibold text-base text-center hover:bg-slate-100 transition-colors inline-flex items-center justify-center gap-2"
            >
              <Phone class="w-4 h-4 text-brand-accent" />
              <span>Call Now ({primary.display})</span>
            </a>
            <a
              href={waHref('Hi, I need help with my appliance.')}
              target="_blank"
              rel="noopener noreferrer"
              class="border border-white/25 text-white px-7 py-3.5 rounded-xl font-semibold text-base text-center hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"
            >
              <MessageCircle class="w-4 h-4 text-brand-accent-light" />
              <span>WhatsApp Us</span>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-6 border-t border-white/10 mb-5">
            <div class="flex items-center space-x-2.5 text-slate-200 text-sm">
              <Wrench class="w-4 h-4 text-brand-accent-light shrink-0" />
              <span>Multi-brand service</span>
            </div>
            <div class="flex items-center space-x-2.5 text-slate-200 text-sm">
              <Home class="w-4 h-4 text-brand-accent-light shrink-0" />
              <span>Doorstep assistance</span>
            </div>
            <div class="flex items-center space-x-2.5 text-slate-200 text-sm">
              <FileCheck class="w-4 h-4 text-brand-accent-light shrink-0" />
              <span>Clear problem explanation</span>
            </div>
          </div>

          <p class="inline-flex items-center gap-2 text-xs sm:text-sm text-slate-300">
            <Clock class="w-4 h-4 text-brand-accent-light shrink-0" />
            <span>Open {siteConfig.hours}</span>
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-white/15 bg-white/5 p-3 shadow-2xl">
            <div class="relative rounded-xl overflow-hidden aspect-[3/2] bg-brand-ink">
              <img
                src={siteConfig.heroImage.src}
                alt={siteConfig.heroImage.alt}
                width="960"
                height="640"
                fetchpriority="high"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-ink/90 via-brand-ink/40 to-transparent p-4">
                <p class="text-xs font-semibold uppercase tracking-wider text-brand-accent-light">
                  {siteConfig.shortName} • {siteConfig.location.city}
                </p>
                <p class="text-sm font-medium text-white">
                  Expert AC, Refrigerator, Washing Machine & Microwave Repair
                </p>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-2.5 mt-2.5">
              <img
                src="/gallery/refrigerator-repair.webp"
                alt="Refrigerator repair service in Kamareddy"
                width="320"
                height="240"
                loading="lazy"
                class="w-full aspect-[4/3] object-cover rounded-lg border border-white/10"
              />
              <img
                src="/gallery/washing-machine-repair.webp"
                alt="Washing machine repair service in Kamareddy"
                width="320"
                height="240"
                loading="lazy"
                class="w-full aspect-[4/3] object-cover rounded-lg border border-white/10"
              />
              <img
                src="/gallery/microwave-oven-repair.webp"
                alt="Microwave oven repair service in Kamareddy"
                width="320"
                height="240"
                loading="lazy"
                class="w-full aspect-[4/3] object-cover rounded-lg border border-white/10"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Appliance Strip -->
  <section class="py-10 bg-white border-b border-brand-line">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {appliances.map((item) => {
          const Icon = item.icon;
          return (
            <div class="flex items-center gap-3.5 p-4 rounded-2xl border border-brand-line bg-brand-paper">
              <div class="w-11 h-11 rounded-xl bg-brand-mist text-brand-accent flex items-center justify-center shrink-0">
                <Icon class="w-5 h-5" />
              </div>
              <span class="font-display font-semibold text-brand-ink text-sm sm:text-base">
                {item.label}
              </span>
            </div>
          );
        })}
      </div>

      {/* PLACEHOLDER: brands list pending client confirmation via siteConfig.brandsConfirmed */}
      {siteConfig.brands.length > 0 && (
        <div class="mt-8 pt-6 border-t border-brand-line flex flex-col md:flex-row md:items-center justify-between gap-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-600 shrink-0">
            Brands we commonly service
          </p>
          <div class="flex flex-wrap gap-2">
            {siteConfig.brands.map((brand) => (
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-brand-mist text-brand-ink border border-brand-line">
                {brand}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- 3. Services Grid -->
  <section class="py-20 md:py-24 bg-brand-paper">
    <div class="container mx-auto px-6">
      <div class="max-w-2xl mb-14">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-accent mb-2">
          Our Services
        </p>
        <h2 class="text-fluid-h2 mb-4">Appliance Repair & Maintenance</h2>
        <p class="text-base md:text-lg text-slate-700">
          {siteConfig.location.serviceAreaText}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {siteConfig.services.map((service) => (
          <ServiceCard {...service} />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Why Choose SS TECHNO -->
  <section class="py-20 md:py-24 bg-white border-y border-brand-line">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-accent mb-2">
            Why Choose {siteConfig.shortName}
          </p>
          <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-ink mb-6 leading-snug">
            Professional Service | Honest Support | Convenient Doorstep Assistance
          </h2>
          <p class="text-slate-700 mb-8 leading-relaxed">
            {siteConfig.mission}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
            {siteConfig.whyChoose.map((point) => (
              <div class="flex items-center space-x-3 p-3.5 rounded-xl bg-brand-paper border border-brand-line">
                <CheckCircle2 class="w-5 h-5 text-brand-accent shrink-0" />
                <span class="text-sm font-medium text-brand-ink">{point}</span>
              </div>
            ))}
          </div>

          <p class="text-lg font-display font-bold text-brand-accent">
            We Keep Your Home Appliances Running.
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-brand-ink text-white p-8 md:p-10 rounded-2xl border border-brand-line space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-brand-accent-light text-xs font-semibold uppercase tracking-wider">
              {siteConfig.shortName} Promise
            </div>
            <h3 class="text-2xl font-display font-bold text-white leading-snug">
              "{siteConfig.tagline}"
            </h3>
            <p class="text-slate-300 text-sm leading-relaxed">
              Our technicians inspect your appliance carefully, identify the actual fault and explain the required repair solution clearly before proceeding with any work.
            </p>
            <div class="pt-4 border-t border-white/10 space-y-3 text-sm text-slate-300">
              <div class="flex items-start gap-2.5">
                <MapPin class="w-4 h-4 text-brand-accent-light shrink-0 mt-0.5" />
                <span>
                  {siteConfig.location.address
                    ? siteConfig.location.address
                    : `${siteConfig.location.city}, ${siteConfig.location.state}`}
                </span>
              </div>
              <div class="flex items-center gap-2.5">
                <Clock class="w-4 h-4 text-brand-accent-light shrink-0" />
                <span>Open {siteConfig.hours}</span>
              </div>
              <div class="flex items-center gap-2.5">
                <UserCheck class="w-4 h-4 text-brand-accent-light shrink-0" />
                <span>Proprietors: {siteConfig.proprietors.join(' & ')}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. How It Works -->
  <section class="py-20 md:py-24 bg-brand-paper">
    <div class="container mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-accent mb-2">
          Our Process
        </p>
        <h2 class="text-fluid-h2 mb-4">How It Works</h2>
        <p class="text-slate-700 text-base md:text-lg">
          Simple, transparent steps from your first call to service completion.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6 relative">
        <div
          class="hidden md:block absolute top-10 left-[10%] right-[10%] h-px bg-brand-line z-0"
          aria-hidden="true"
        ></div>

        {siteConfig.process.map((item) => (
          <div class="relative z-10 bg-white md:bg-transparent p-6 md:p-2 rounded-2xl border border-brand-line md:border-0 text-left md:text-center">
            <div class="w-16 h-16 md:mx-auto bg-white border-2 border-brand-accent text-brand-accent rounded-2xl flex items-center justify-center text-xl font-display font-bold mb-4 shadow-sm">
              {item.step}
            </div>
            <h3 class="text-base font-bold text-brand-ink mb-2">{item.title}</h3>
            <p class="text-slate-700 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- 6. Reviews -->
  <section class="py-20 md:py-24 bg-white border-t border-brand-line">
    <div class="container mx-auto px-6">
      <div class="flex flex-col md:flex-row justify-between md:items-end mb-12 gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-accent mb-2">
            Customer Feedback
          </p>
          <h2 class="text-fluid-h2">What Customers Say</h2>
        </div>
        <a
          href="/reviews"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-accent hover:text-brand-ink transition-colors"
        >
          <span>View all reviews</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {siteConfig.reviews.map((review) => (
          <TestimonialCard text={review.text} author={review.author} />
        ))}
      </div>
    </div>
  </section>

  <!-- 7. CTA Band (Dark) -->
  <section class="py-16 md:py-20 bg-brand-ink text-white">
    <div class="container mx-auto px-6">
      <div class="rounded-2xl border border-white/15 bg-white/5 p-8 md:p-12 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
        <div class="max-w-2xl">
          <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-3">
            Need Appliance Repair?
          </h2>
          <p class="text-slate-300 text-base md:text-lg mb-6">
            Don't let a faulty appliance disturb your daily routine.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-300">
            <div>
              <span class="text-slate-400 block text-xs uppercase tracking-wider">Phones</span>
              {siteConfig.contact.phones.map((p, idx) => (
                <>
                  <a href={telHref(p.e164)} class="font-semibold text-white hover:text-brand-accent-light">
                    {p.display}
                  </a>
                  {idx < siteConfig.contact.phones.length - 1 && <span> / </span>}
                </>
              ))}
            </div>
            <div>
              <span class="text-slate-400 block text-xs uppercase tracking-wider">Proprietors</span>
              <span class="font-medium text-white">{siteConfig.proprietors.join(' & ')}</span>
            </div>
            <div>
              <span class="text-slate-400 block text-xs uppercase tracking-wider">Shop Address</span>
              <span class="font-medium text-white">
                {siteConfig.location.address ?? `${siteConfig.location.city}, ${siteConfig.location.state}`}
              </span>
            </div>
            <div>
              <span class="text-slate-400 block text-xs uppercase tracking-wider">Working Hours</span>
              <span class="font-medium text-white">{siteConfig.hours}</span>
            </div>
            {siteConfig.contact.email && (
              <div class="sm:col-span-2">
                <span class="text-slate-400 block text-xs uppercase tracking-wider">Email</span>
                <a href={`mailto:${siteConfig.contact.email}`} class="font-medium text-white hover:text-brand-accent-light">
                  {siteConfig.contact.email}
                </a>
              </div>
            )}
          </div>
        </div>

        <div class="flex flex-col sm:flex-row lg:flex-col gap-3 w-full lg:w-auto shrink-0">
          <a
            href="#booking"
            class="bg-brand-accent text-white px-7 py-3.5 rounded-xl font-semibold text-sm text-center hover:bg-brand-accent/90 transition-colors"
          >
            Book a Service
          </a>
          <a
            href={telHref(primary.e164)}
            class="bg-white text-brand-ink px-7 py-3.5 rounded-xl font-semibold text-sm text-center hover:bg-slate-100 transition-colors inline-flex items-center justify-center gap-2"
          >
            <Phone class="w-4 h-4 text-brand-accent" />
            <span>Call {primary.display}</span>
          </a>
          <a
            href={waHref('Hi, I need help with my appliance.')}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-white/25 text-white px-7 py-3.5 rounded-xl font-semibold text-sm text-center hover:bg-white/10 transition-colors inline-flex items-center justify-center gap-2"
          >
            <MessageCircle class="w-4 h-4 text-brand-accent-light" />
            <span>WhatsApp Us</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FAQ + BookingForm -->
  <section class="py-20 md:py-24 bg-brand-paper">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-5">
          <p class="text-xs font-semibold uppercase tracking-widest text-brand-accent mb-2">
            Common Questions
          </p>
          <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-ink mb-6">
            Frequently Asked Questions
          </h2>
          <FAQAccordion faqs={siteConfig.faqs} />
        </div>

        <div class="lg:col-span-7">
          <BookingForm id="booking" />
        </div>
      </div>
    </div>
  </section>
</Layout>

