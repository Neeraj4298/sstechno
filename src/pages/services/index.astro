---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';
import ServiceCard from '../../components/ServiceCard.astro';
---

<Layout
  title={`Appliance Repair Services in ${siteConfig.location.city} | ${siteConfig.shortName}`}
  description={`AC, refrigerator, washing machine and microwave oven repair, spare parts and home appliance maintenance in ${siteConfig.location.city}, ${siteConfig.location.state}.`}
>
  <section class="pt-32 pb-16 md:pt-36 md:pb-20 bg-brand-ink text-white">
    <div class="container mx-auto px-6 max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-accent-light mb-3">
        {siteConfig.footerLine}
      </p>
      <h1 class="text-fluid-h1 text-white mb-4">Our Services</h1>
      <p class="text-lg text-slate-300">
        {siteConfig.location.serviceAreaText}
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-brand-paper">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {siteConfig.services.map((service) => (
          <ServiceCard {...service} />
        ))}
      </div>
    </div>
  </section>
</Layout>

