---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';
import BookingForm from '../../components/BookingForm.astro';
import { CheckCircle2, Info } from 'lucide-astro';

export function getStaticPaths() {
  return siteConfig.services.map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const hasProblems = service.problems && service.problems.length > 0;
---

<Layout
  title={`${service.title} in ${siteConfig.location.city} | ${siteConfig.shortName}`}
  description={`${service.shortDescription} Doorstep assistance in ${siteConfig.location.city}, ${siteConfig.location.state} by ${siteConfig.shortName}.`}
  image={service.image ?? undefined}
>
  <section class="pt-32 pb-16 md:pt-36 md:pb-20 bg-brand-ink text-white">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl">
        <a
          href="/services"
          class="text-sm font-medium text-brand-accent-light mb-5 inline-block hover:underline"
        >
          &larr; All Services
        </a>
        <h1 class="text-fluid-h1 text-white mb-4">{service.title}</h1>
        <p class="text-lg md:text-xl text-slate-300 leading-relaxed">
          {service.shortDescription}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-brand-paper">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7 space-y-12">
          {service.image && (
            <figure class="rounded-2xl overflow-hidden border border-brand-line bg-white shadow-sm">
              <img
                src={service.image}
                alt={`${service.title} by ${siteConfig.shortName} in ${siteConfig.location.city}`}
                width="960"
                height="640"
                class="w-full aspect-[16/10] object-cover"
              />
            </figure>
          )}

          {hasProblems ? (
            <div>
              <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-ink mb-6">
                Common problems we fix
              </h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {service.problems.map((problem: string) => (
                  <div class="flex items-start space-x-3 p-4 rounded-2xl bg-white border border-brand-line shadow-sm">
                    <CheckCircle2 class="w-5 h-5 text-brand-accent shrink-0 mt-0.5" />
                    <span class="text-sm font-medium text-brand-ink">{problem}</span>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <div class="p-6 rounded-2xl bg-white border border-brand-line shadow-sm flex items-start gap-3.5">
              <Info class="w-5 h-5 text-brand-accent shrink-0 mt-0.5" />
              <p class="text-slate-700 font-medium">
                Ask us about availability and compatibility.
              </p>
            </div>
          )}

          <div>
            <h2 class="text-2xl md:text-3xl font-display font-bold text-brand-ink mb-6">
              Our Service Process
            </h2>
            <div class="space-y-4">
              {siteConfig.process.map((step) => (
                <div class="flex items-start gap-4 p-5 rounded-2xl bg-white border border-brand-line shadow-sm">
                  <span class="w-10 h-10 rounded-xl bg-brand-mist text-brand-accent font-display font-bold text-sm flex items-center justify-center shrink-0">
                    {step.step}
                  </span>
                  <div>
                    <h3 class="font-bold text-brand-ink text-base mb-1">{step.title}</h3>
                    <p class="text-sm text-slate-700">{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="sticky top-24">
            <BookingForm defaultService={service.title} id="booking" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

