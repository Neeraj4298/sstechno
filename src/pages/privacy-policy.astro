---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { primaryPhone, telHref } from '../lib/contact';

const primary = primaryPhone();
---

<Layout
  title={`Privacy Policy | ${siteConfig.shortName}`}
  description={`Privacy Policy for ${siteConfig.businessName} in ${siteConfig.location.city}, ${siteConfig.location.state}.`}
>
  <section class="pt-32 pb-20 md:pt-36 md:pb-24 bg-brand-paper">
    <div class="container mx-auto px-6 max-w-3xl">
      <div class="bg-white p-8 md:p-12 rounded-2xl border border-brand-line shadow-sm prose prose-slate max-w-none prose-headings:font-display prose-headings:text-brand-ink prose-a:text-brand-accent">
        <h1>Privacy Policy</h1>
        <p class="text-sm text-slate-500">Last updated: November 12, 2026</p>

        <p>
          {siteConfig.businessName} ("{siteConfig.shortName}", "we", "us", or "our") respects your privacy and is committed to handling your personal information responsibly when you contact us or request an appliance repair visit in {siteConfig.location.city}, {siteConfig.location.state}.
        </p>

        <h2>1. Information You Provide</h2>
        <p>
          When you call us, message us on WhatsApp, or use our Book a Service form, you may share:
        </p>
        <ul>
          <li>Your name and phone number</li>
          <li>Your area, locality, or address for doorstep service</li>
          <li>Details about your appliance and the issue you are experiencing</li>
        </ul>

        <h2>2. How We Use Your Information</h2>
        <p>
          We use the details you share solely to respond to your inquiry, coordinate technician visits, perform the requested appliance service, and communicate with you regarding your repair.
        </p>

        <h2>3. WhatsApp Communication</h2>
        <p>
          Our booking form prepares a WhatsApp message on your device so you can send your service request directly to our team. We do not sell or rent your contact details to third-party marketers.
        </p>

        <h2>4. Contact Us</h2>
        <p>
          If you have any questions about this Privacy Policy, please call us at{' '}
          <a href={telHref(primary.e164)}>{primary.display}</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

