---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { primaryPhone, telHref } from '../lib/contact';

const primary = primaryPhone();
---

<Layout
  title={`Page Not Found | ${siteConfig.shortName}`}
  description={`The page you are looking for could not be found on ${siteConfig.businessName}.`}
  noindex={true}
>
  <section class="pt-36 pb-24 bg-brand-paper">
    <div class="container mx-auto px-6 max-w-xl text-center">
      <div class="bg-white p-8 md:p-12 rounded-2xl border border-brand-line shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-widest text-brand-accent mb-2">
          Error 404
        </p>
        <h1 class="text-3xl md:text-4xl font-display font-bold text-brand-ink mb-4">
          Page Not Found
        </h1>
        <p class="text-slate-700 mb-8">
          Sorry, the page you are looking for doesn't exist or has been moved.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/"
            class="bg-brand-accent text-white px-6 py-3 rounded-xl font-semibold text-sm hover:bg-brand-accent/90 transition-colors"
          >
            Back to Home
          </a>
          <a
            href={telHref(primary.e164)}
            class="border border-brand-ink text-brand-ink px-6 py-3 rounded-xl font-semibold text-sm hover:bg-brand-mist transition-colors"
          >
            Call {primary.display}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
