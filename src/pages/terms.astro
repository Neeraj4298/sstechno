---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout title={`Terms of Service | ${siteConfig.businessName}`} description="Terms of Service">
  <section class="pt-32 pb-24 bg-white">
    <div class="container mx-auto px-6 max-w-3xl prose prose-slate">
      <h1 class="text-fluid-h2 font-display font-bold text-brand-navy mb-8">Terms of Service</h1>
      <p class="text-slate-600 mb-6">Last updated: {new Date().toLocaleDateString()}</p>
      
      <h2 class="text-2xl font-bold text-brand-navy mt-12 mb-4">1. Service Agreement</h2>
      <p class="text-slate-600 mb-6">
        By booking a service with {siteConfig.businessName}, you agree to these terms. We will provide a written quote before commencing any repair work. The initial inspection is free only if the repair quote is accepted; otherwise, a visiting fee applies.
      </p>

      <h2 class="text-2xl font-bold text-brand-navy mt-12 mb-4">2. Warranty</h2>
      <p class="text-slate-600 mb-6">
        We offer a 90-day warranty on our workmanship and any new parts supplied and installed by us. This warranty does not cover issues unrelated to our repair or damages caused by misuse.
      </p>
    </div>
  </section>
</Layout>
