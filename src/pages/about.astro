---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout title={`About Us | ${siteConfig.businessName}`} description={`Learn about ${siteConfig.businessName}, our mission, and our commitment to premium AC service.`}>
  <section class="pt-32 pb-24 bg-brand-navy text-white">
    <div class="container mx-auto px-6 max-w-4xl">
      <h1 class="text-fluid-h1 mb-8">Redefining AC Care in {siteConfig.location.city}</h1>
      <p class="text-xl text-brand-frost/90 leading-relaxed">
        For over {siteConfig.stats.years} years, we've been on a mission to elevate the standard of home services. We believe that inviting a technician into your home shouldn't be stressful.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <!-- PLACEHOLDER: Team working or founder -->
          <div class="aspect-square bg-slate-100 rounded-3xl overflow-hidden relative">
            <img src="https://images.unsplash.com/photo-1574360741628-8686d11a2f64?q=80&w=1200&auto=format&fit=crop" alt="Team at work" class="w-full h-full object-cover" />
          </div>
        </div>
        <div>
          <h2 class="text-3xl font-display font-bold text-brand-navy mb-6">Our Philosophy</h2>
          <p class="text-lg text-slate-600 mb-6 leading-relaxed">
            Most local repair services operate on a "break-fix" mentality with little regard for customer experience. We built {siteConfig.businessName} differently. 
          </p>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed">
            We invest in continuous training for our technicians, use state-of-the-art diagnostic tools, and insist on transparent pricing. When you choose us, you're not just getting a repair; you're getting peace of mind.
          </p>
          <div class="grid grid-cols-2 gap-8 py-8 border-t border-slate-100">
            <div>
              <div class="text-4xl font-display font-bold text-brand-accent mb-2">{siteConfig.stats.homesServed}</div>
              <div class="text-sm font-medium text-slate-500 uppercase tracking-wider">Homes Served</div>
            </div>
            <div>
              <div class="text-4xl font-display font-bold text-brand-accent mb-2">{siteConfig.stats.rating}</div>
              <div class="text-sm font-medium text-slate-500 uppercase tracking-wider">Average Rating</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
