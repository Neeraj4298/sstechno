---
import * as Lucide from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  price: number;
  icon: string;
  priceLabel?: string;
  id: string;
}

const { title, description, price, icon, priceLabel, id } = Astro.props;

// @ts-ignore
const IconComponent = Lucide[icon] || Lucide.Settings;
---

<a href={`/services/${id}`} class="group bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:shadow-xl hover:shadow-brand-navy/5 hover:-translate-y-1 transition-all duration-300 flex flex-col h-full">
  <div class="w-12 h-12 bg-brand-frost/50 text-brand-accent rounded-2xl flex items-center justify-center mb-6 group-hover:bg-brand-accent group-hover:text-white transition-colors duration-300">
    <IconComponent class="w-6 h-6" />
  </div>
  <h3 class="text-xl font-bold mb-3">{title}</h3>
  <p class="text-slate-600 mb-8 flex-grow">{description}</p>
  <div class="flex items-center justify-between mt-auto pt-6 border-t border-slate-100">
    <div>
      <span class="text-sm text-slate-500 block mb-1">Starting from</span>
      <span class="font-display font-bold text-lg text-brand-navy">
        {price > 0 ? `₹${price}` : (priceLabel || 'Custom')}
      </span>
    </div>
    <div class="w-10 h-10 rounded-full bg-brand-white flex items-center justify-center group-hover:bg-brand-navy group-hover:text-white transition-colors">
      <Lucide.ArrowRight class="w-4 h-4" />
    </div>
  </div>
</a>
