---
import * as Lucide from 'lucide-astro';

interface Props {
  id: string;
  title: string;
  shortDescription?: string;
  description?: string;
  icon: string;
  image?: string | null;
}

const { id, title, shortDescription, description, icon, image } = Astro.props;
const summary = shortDescription ?? description ?? '';

// @ts-ignore
const IconComponent = Lucide[icon] || Lucide.Settings;
---

<a
  href={`/services/${id}`}
  class="group bg-white rounded-2xl shadow-sm border border-brand-line hover:-translate-y-0.5 hover:border-brand-accent/40 transition-all duration-200 flex flex-col h-full overflow-hidden"
>
  {image && (
    <div class="relative w-full aspect-[16/10] bg-brand-mist overflow-hidden border-b border-brand-line">
      <img
        src={image}
        alt={title}
        width="640"
        height="400"
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}
  <div class="p-7 flex flex-col flex-grow">
    <div class="w-12 h-12 bg-brand-mist text-brand-accent rounded-xl flex items-center justify-center mb-5 group-hover:bg-brand-accent group-hover:text-white transition-colors duration-200">
      <IconComponent class="w-6 h-6" />
    </div>
    <h3 class="text-xl font-bold text-brand-ink mb-2.5">{title}</h3>
    <p class="text-slate-700 text-sm leading-relaxed mb-6 flex-grow">{summary}</p>
    <div class="pt-4 border-t border-brand-line mt-auto flex items-center justify-between text-sm font-semibold text-brand-accent group-hover:text-brand-ink transition-colors">
      <span>Learn more &rarr;</span>
    </div>
  </div>
</a>


