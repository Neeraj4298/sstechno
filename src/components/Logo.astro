---
import { siteConfig } from '../config/site';

interface Props {
  dark?: boolean;
  showDescriptor?: boolean;
}

const { dark = false, showDescriptor = false } = Astro.props;
---

<!-- PLACEHOLDER: replace with client logo -->
<span class="inline-flex items-center gap-3">
  <svg
    width="40"
    height="40"
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="shrink-0"
    aria-hidden="true"
  >
    <rect width="40" height="40" rx="10" fill="#0B0F14" stroke="#2DD4BF" stroke-opacity="0.25" />
    <text
      x="20"
      y="25.5"
      text-anchor="middle"
      fill="#2DD4BF"
      font-family="Plus Jakarta Sans, Inter, sans-serif"
      font-weight="800"
      font-size="16"
      letter-spacing="-0.5"
    >SS</text>
  </svg>
  <span class="flex flex-col leading-tight">
    <span class={`font-display font-bold text-lg tracking-tight ${dark ? 'text-white' : 'text-brand-ink'}`}>
      {siteConfig.shortName}
    </span>
    {showDescriptor && (
      <span class={`hidden md:block text-xs font-medium ${dark ? 'text-slate-400' : 'text-slate-600'}`}>
        {siteConfig.descriptor}
      </span>
    )}
  </span>
</span>
