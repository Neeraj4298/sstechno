---
---

<div class="relative w-full max-w-4xl mx-auto h-[400px] md:h-[500px] rounded-3xl overflow-hidden shadow-2xl group" id="ba-slider">
  <!-- Before Image (Dirty) -->
  <div class="absolute inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?q=80&w=1200&auto=format&fit=crop" alt="Dirty AC Filter" class="w-full h-full object-cover grayscale brightness-75" />
    <div class="absolute top-6 right-6 bg-brand-navy/80 backdrop-blur text-white px-4 py-1.5 rounded-full text-sm font-medium z-10">Before</div>
  </div>

  <!-- After Image (Clean) -->
  <div class="absolute inset-0 z-10 w-[50%] overflow-hidden border-r-4 border-brand-accent shadow-[4px_0_15px_rgba(0,0,0,0.2)]" id="ba-after">
    <!-- PLACEHOLDER: The image itself needs fixed width relative to container to not stretch -->
    <div class="absolute inset-0 w-[100vw] max-w-4xl h-full">
      <img src="https://images.unsplash.com/photo-1621905252507-b35492f0402e?q=80&w=1200&auto=format&fit=crop" alt="Clean AC Filter" class="w-full h-full object-cover" />
    </div>
    <div class="absolute top-6 left-6 bg-brand-accent/90 backdrop-blur text-white px-4 py-1.5 rounded-full text-sm font-medium z-10">After</div>
  </div>

  <!-- Slider Handle -->
  <div class="absolute top-0 bottom-0 left-[50%] w-10 -ml-5 z-20 flex items-center justify-center cursor-ew-resize" id="ba-handle">
    <div class="w-10 h-10 bg-white rounded-full shadow-lg flex items-center justify-center text-brand-navy">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l-4 4 4 4m8-8l4 4-4 4"></path></svg>
    </div>
  </div>
  
  <input type="range" min="0" max="100" value="50" class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30" id="ba-input" />
</div>

<script>
  const slider = document.getElementById('ba-slider');
  const after = document.getElementById('ba-after');
  const handle = document.getElementById('ba-handle');
  const input = document.getElementById('ba-input') as HTMLInputElement;

  if (input && after && handle) {
    input.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      after.style.width = `${val}%`;
      handle.style.left = `${val}%`;
    });
  }
</script>
