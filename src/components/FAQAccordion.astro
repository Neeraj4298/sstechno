---
import { ChevronDown } from 'lucide-astro';

interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<div class="space-y-4 max-w-3xl mx-auto">
  {faqs.map((faq) => (
    <details class="group bg-white rounded-2xl border border-brand-line shadow-sm overflow-hidden [&_summary::-webkit-details-marker]:hidden">
      <summary class="flex cursor-pointer items-center justify-between gap-3 p-5 font-semibold text-brand-ink hover:text-brand-accent transition-colors">
        <span>{faq.question}</span>
        <span class="shrink-0 rounded-full bg-brand-mist p-2 text-brand-ink transition duration-200 group-open:-rotate-180">
          <ChevronDown class="w-4 h-4" />
        </span>
      </summary>
      <div class="px-5 pb-5 text-slate-700 text-sm leading-relaxed border-t border-brand-line/60 pt-4">
        <p>{faq.answer}</p>
      </div>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<style>
  details > summary { list-style: none; }
</style>

