---
import { primaryPhone, telHref, waHref } from '../lib/contact';
import { Phone, MessageCircle } from 'lucide-astro';

const primary = primaryPhone();
---

<div class="md:hidden fixed bottom-0 left-0 w-full bg-brand-paper border-t border-brand-line z-50 p-3 pb-safe shadow-sm">
  <div class="grid grid-cols-2 gap-3">
    <a
      href={telHref(primary.e164)}
      class="flex items-center justify-center space-x-2 border border-brand-ink bg-white text-brand-ink rounded-xl py-3 font-medium text-sm"
    >
      <Phone class="w-4 h-4 text-brand-accent" />
      <span>Call Now</span>
    </a>
    <a
      href={waHref('Hi, I need help with my appliance.')}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center space-x-2 bg-brand-accent text-white rounded-xl py-3 font-medium text-sm shadow-sm"
    >
      <MessageCircle class="w-4 h-4" />
      <span>WhatsApp</span>
    </a>
  </div>
</div>
<style>
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom, 0.75rem);
  }
</style>

