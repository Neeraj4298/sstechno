---
import { siteConfig } from '../config/site';
---

<footer class="bg-brand-navy text-brand-frost pt-20 pb-24 md:pb-8">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="text-2xl font-display font-bold text-white mb-4 block">
          {siteConfig.businessName}
        </a>
        <p class="text-brand-frost/80 mb-6">{siteConfig.tagline}</p>
        <p class="text-sm text-brand-frost/60 mb-2">{siteConfig.location.address}</p>
        <p class="text-sm text-brand-frost/60">{siteConfig.hours}</p>
      </div>
      
      <div>
        <h4 class="text-white font-semibold mb-6">Services</h4>
        <ul class="space-y-4">
          {siteConfig.services.map(s => (
            <li><a href={`/services/${s.id}`} class="text-brand-frost/80 hover:text-white transition-colors">{s.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-6">Company</h4>
        <ul class="space-y-4">
          <li><a href="/about" class="text-brand-frost/80 hover:text-white transition-colors">About Us</a></li>
          <li><a href="/blog" class="text-brand-frost/80 hover:text-white transition-colors">Blog</a></li>
          <li><a href="/contact" class="text-brand-frost/80 hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-6">Contact</h4>
        <ul class="space-y-4 text-brand-frost/80">
          <li><a href={`tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, '')}`} class="hover:text-white transition-colors">{siteConfig.contact.phone}</a></li>
          <li><a href={`mailto:${siteConfig.contact.email}`} class="hover:text-white transition-colors">{siteConfig.contact.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row items-center justify-between text-sm text-brand-frost/50">
      <p>&copy; {new Date().getFullYear()} {siteConfig.businessName}. All rights reserved.</p>
      <div class="flex space-x-6 mt-4 md:mt-0">
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
