---
import { Star } from 'lucide-astro';

interface Props {
  name: string;
  location: string;
  service: string;
  text: string;
  rating?: number;
}

const { name, location, service, text, rating = 5 } = Astro.props;
---

<div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm flex flex-col h-full">
  <div class="flex space-x-1 text-amber-400 mb-6">
    {Array.from({ length: 5 }).map((_, i) => (
      <Star class={`w-4 h-4 ${i < rating ? 'fill-current' : 'text-slate-200'}`} />
    ))}
  </div>
  <p class="text-slate-700 mb-8 flex-grow leading-relaxed">"{text}"</p>
  <div class="flex items-center mt-auto">
    <div class="w-12 h-12 bg-brand-frost rounded-full flex items-center justify-center text-brand-navy font-bold text-lg mr-4">
      {name.charAt(0)}
    </div>
    <div>
      <h4 class="font-bold text-brand-navy">{name}</h4>
      <p class="text-sm text-slate-500">{location} • {service}</p>
    </div>
  </div>
</div>
