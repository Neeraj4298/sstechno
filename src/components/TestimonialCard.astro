---
import { Quote } from 'lucide-astro';
import { siteConfig } from '../config/site';

interface Props {
  text: string;
  author?: string | null;
  name?: string | null;
  location?: string | null;
  service?: string | null;
}

const { text, author = null, name = null, location = null, service = null } = Astro.props;
const displayName = author || name || null;
const subtitleParts = [location || siteConfig.location.city, service].filter(Boolean);
---

<div class="bg-white p-7 rounded-2xl border border-brand-line shadow-sm flex flex-col h-full">
  <div class="w-10 h-10 rounded-xl bg-brand-mist text-brand-accent flex items-center justify-center mb-5 shrink-0">
    <Quote class="w-5 h-5" />
  </div>
  <p class="text-slate-700 mb-6 flex-grow leading-relaxed text-base">"{text}"</p>
  <div class="flex items-center mt-auto pt-4 border-t border-brand-line">
    <div class="w-10 h-10 bg-brand-mist rounded-full flex items-center justify-center text-brand-ink font-bold text-sm mr-3 shrink-0">
      {displayName ? displayName.charAt(0).toUpperCase() : <Quote class="w-4 h-4 text-brand-accent" />}
    </div>
    <div>
      <p class="font-semibold text-brand-ink text-sm">
        {displayName ? displayName : `Customer, ${siteConfig.location.city}`}
      </p>
      {displayName && subtitleParts.length > 0 && (
        <p class="text-xs text-slate-600">{subtitleParts.join(' • ')}</p>
      )}
    </div>
  </div>
</div>

