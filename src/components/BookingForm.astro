---
import { siteConfig } from '../config/site';
---

<div class="bg-white p-8 md:p-12 rounded-3xl shadow-xl border border-slate-100 relative overflow-hidden" id="booking">
  <div class="absolute top-0 right-0 w-64 h-64 bg-brand-frost rounded-full blur-3xl opacity-50 -translate-y-1/2 translate-x-1/3"></div>
  
  <h3 class="text-3xl font-display font-bold mb-2 relative z-10">Book Free Inspection</h3>
  <p class="text-slate-600 mb-8 relative z-10">Fill out the details below and we'll reach out via WhatsApp to confirm your slot.</p>

  <form id="booking-form" class="space-y-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="name" class="block text-sm font-medium text-slate-700 mb-2">Your Name</label>
        <input type="text" id="name" required class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-transparent transition-shadow" placeholder="e.g. Rahul Sharma" />
      </div>
      <div>
        <label for="phone" class="block text-sm font-medium text-slate-700 mb-2">Phone Number</label>
        <input type="tel" id="phone" required class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-transparent transition-shadow" placeholder="10-digit mobile" />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="area" class="block text-sm font-medium text-slate-700 mb-2">Area / Locality</label>
        <select id="area" required class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-transparent transition-shadow bg-white">
          <option value="" disabled selected>Select your area</option>
          {siteConfig.location.areas.map(area => (
            <option value={area}>{area}</option>
          ))}
          <option value="other">Other (specify in details)</option>
        </select>
      </div>
      <div>
        <label for="serviceType" class="block text-sm font-medium text-slate-700 mb-2">Service Required</label>
        <select id="serviceType" required class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-transparent transition-shadow bg-white">
          <option value="" disabled selected>What do you need help with?</option>
          {siteConfig.services.map(s => (
            <option value={s.title}>{s.title}</option>
          ))}
        </select>
      </div>
    </div>

    <div>
      <label for="details" class="block text-sm font-medium text-slate-700 mb-2">Issue Details (Optional)</label>
      <textarea id="details" rows="3" class="w-full px-4 py-3 rounded-2xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-transparent transition-shadow" placeholder="E.g., AC is not cooling, making noise, or needs installation..."></textarea>
    </div>

    <button type="submit" class="w-full bg-brand-navy text-white font-medium text-lg py-4 rounded-full hover:bg-brand-navy/90 transition-colors shadow-lg shadow-brand-navy/20 flex justify-center items-center space-x-2">
      <span>Book via WhatsApp</span>
    </button>
  </form>
</div>

<script define:vars={{ whatsappNumber: siteConfig.contact.whatsapp }}>
  const form = document.getElementById('booking-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = document.getElementById('name').value;
    const phone = document.getElementById('phone').value;
    const area = document.getElementById('area').value;
    const serviceType = document.getElementById('serviceType').value;
    const details = document.getElementById('details').value;

    const message = `Hello, I would like to book a service.%0A%0A*Name:* ${name}%0A*Phone:* ${phone}%0A*Area:* ${area}%0A*Service:* ${serviceType}%0A*Details:* ${details || 'None'}`;
    const cleanNumber = whatsappNumber.replace(/[^0-9+]/g, '');
    const url = `https://wa.me/${cleanNumber}?text=${message}`;
    
    window.open(url, '_blank');
  });
</script>
